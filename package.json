{
  "name": "tactics-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ブラウザで遊べるタクティクスRPG",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.core.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "autoplay": "node scripts/autoplay.mjs",
    "autoplay:ci": "node scripts/autoplay.mjs --quick",
    "script-rules": "vitest run src/data/story/story.test.ts src/data/story/scriptTiming.test.ts --silent=false -t \"台本の決まり|見込み\"",
    "balance": "node scripts/balance.mjs",
    "script-export": "node scripts/script-export.mjs",
    "story-shots": "node scripts/story-shots.mjs",
    "render-perf": "node scripts/render-perf.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/shippori-antique": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "@fontsource/zen-old-mincho": "^5.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
